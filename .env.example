# This value is already configured in Vercel for production (both projects).
# Use this file only for local development with `vercel dev` or a Node server.
#
# 1. Message @BotFather on Telegram, send /newbot, and copy the HTTP API token.
# 2. Add that bot to the @zarsstudy channel (administrator is recommended).
# 3. Put the token below locally, and set the same value as an environment
#    variable named TELEGRAM_BOT_TOKEN in your Vercel project settings.
#
# NEVER commit a real token. .env files are gitignored in this repo.
TELEGRAM_BOT_TOKEN=
